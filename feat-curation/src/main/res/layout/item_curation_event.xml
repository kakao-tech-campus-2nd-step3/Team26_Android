<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="eventResponse"
            type="org.ktc2.cokaen.wouldyouin.data.model.CurationEventResponse" />
        <variable
            name="imageUrl"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/rounded_background"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/eventImage"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Poster"
            android:layout_marginEnd="8dp"
            imageUrl="@{eventResponse.thumbnailImageUrl}" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{eventResponse.title}"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                tools:text="Title"
                android:textSize="18sp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/eventHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{eventResponse.hostNickname}"
                android:layout_marginTop="5dp"
                tools:text="주최자"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/eventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2024.07.15.15:00"
                android:layout_marginTop="5dp"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/eventLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@{eventResponse.location.detailAddress}"
                android:textSize="14sp"
                tools:text="광주 문화전당로 보헤미안 소극장"
                android:textColor="#666666" />
        </LinearLayout>
    </LinearLayout>
</layout>
